# HTTPS with automatic Let's Encrypt certificates. SITE_DOMAIN comes from .env (e.g. redecorgroup.com).
{$SITE_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 120MB
	}
	header {
		-Server
	}
	reverse_proxy web:8000 {
		health_uri /api/health
	}
	log {
		output stdout
		format console
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
