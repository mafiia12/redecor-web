# Staging settings (new.redecorgroup.com). Copy to .env.staging on the server, `chmod 600 .env.staging`,
# fill in, then check:  python tools/check_env.py .env.staging
# NEVER commit .env.staging. Use DIFFERENT secrets from production.
APP_ENV=staging
SITE_DOMAIN=new.redecorgroup.com
SITE_URL=https://new.redecorgroup.com
# Canonical domain of the live site (used for canonical links / redirects)
PRIMARY_DOMAIN=redecorgroup.com
# 48+ random characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# First admin account (created on first start only, when no admin exists). 12+ characters.
# ADMIN_PASSWORD can be cleared after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO=0
ALLOW_TEST_CONTENT=0
# Keep approvals on so staging behaves like production
ENFORCE_APPROVALS=1

# Admin session length (hours). Empty = app default.
TOKEN_HOURS=
# Optional token for the detailed health endpoint. Empty = disabled.
HEALTH_TOKEN=
# Optional old-site redirect map file. Empty = none.
REDIRECTS_FILE=
# Comma-separated extra allowed origins. Empty = same origin only.
CORS_ORIGINS=

# Enquiry e-mails. Leave SMTP_HOST, MAIL_FROM, NOTIFY_TO all empty to disable, or fill all three.
# SMTP_USER/SMTP_PASSWORD: both or neither. (Microsoft 365: smtp.office365.com 587 starttls)
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Comma-separated recipients
NOTIFY_TO=
# Retries for failed notification e-mails. Empty = app defaults.
NOTIFY_MAX_ATTEMPTS=
NOTIFY_RETRY_SECONDS=

# Daily enquiry digest at HH:MM (24h). Empty = no digest. Needs SMTP.
DIGEST_TIME=
DIGEST_TZ=Africa/Cairo

# Virus scanning of enquiry attachments (start compose with --profile virus-scan, then
# VIRUS_SCAN_ENABLED=1, CLAMAV_HOST=clamav, CLAMAV_PORT=3310)
VIRUS_SCAN_ENABLED=0
CLAMAV_HOST=
CLAMAV_PORT=

# Attachment limits. Empty = app defaults.
ATTACH_MAX_FILE_MB=
ATTACH_MAX_FILES=
ATTACH_MAX_TOTAL_MB=

# Project image quality limits. Empty = app defaults.
IMAGE_MIN_LONG_EDGE=
IMAGE_MIN_COVER_LONG_EDGE=
IMAGE_ASPECT_MIN=
IMAGE_ASPECT_MAX=

# Optional: alerts (failed notifications, server errors, failed backups) to a Slack/Teams/Discord webhook (https:// only)
ALERT_WEBHOOK_URL=
# Backups (the backup service writes to /data/backups inside the staging volume)
BACKUP_KEEP=7
BACKUP_COPY_TO=

# Social links shown in the footer. Empty = none.
SOCIAL_LINKS=
