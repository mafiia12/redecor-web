# Local development. Copy to backend/.env (never commit .env)
APP_ENV=development
DATABASE_URL=sqlite:///./redecor.db
# PostgreSQL example: postgresql+psycopg://user:pass@localhost:5432/redecor  (pip install "psycopg[binary]")
SECRET_KEY=change-me-to-a-long-random-string-of-48-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Strong-password-2026
SITE_URL=http://localhost:8001
UPLOAD_DIR=./uploads
CORS_ORIGINS=
# 1 = create "[placeholder]" demo rows for design work (never shown publicly)
SEED_DEMO=0
# 1 = show test-project-* pages (local preview only)
ALLOW_TEST_CONTENT=0
# Optional e-mail notifications (see docs/DEPLOYMENT_GUIDE.md)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
NOTIFY_TO=
# ---- Batch 2 (optional; defaults shown; see the root .env.example for explanations) ----
PRIMARY_DOMAIN=redecorgroup.com
HEALTH_TOKEN=
REDIRECTS_FILE=
# Leave 1 (publication gate). 0 only for local design work; refused in production.
ENFORCE_APPROVALS=1
IMAGE_MIN_LONG_EDGE=1600
IMAGE_MIN_COVER_LONG_EDGE=2400
IMAGE_ASPECT_MIN=0.5
IMAGE_ASPECT_MAX=2.4
ATTACHMENTS_DIR=./attachments
ATTACH_MAX_FILES=3
ATTACH_MAX_FILE_MB=15
ATTACH_MAX_TOTAL_MB=30
VIRUS_SCAN_ENABLED=0
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
DIGEST_TIME=
DIGEST_TZ=Africa/Cairo
