# Production settings. Copy to .env on the server and fill in. NEVER commit .env.
APP_ENV=production
SITE_DOMAIN=redecorgroup.com
SITE_URL=https://redecorgroup.com
# 48+ random characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# First admin account (created on first start). 12+ characters, letters and numbers/symbols.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO=0
ALLOW_TEST_CONTENT=0

# Enquiry e-mails (ask the e-mail provider for these; Microsoft 365: smtp.office365.com 587 starttls)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
NOTIFY_TO=

# Optional: alerts (failed notifications, server errors, failed backups) to a Slack/Teams/Discord webhook
ALERT_WEBHOOK_URL=
# Backups (the backup service writes to /data/backups inside the volume)
BACKUP_KEEP=14
BACKUP_COPY_TO=

# ---- Batch 2 settings (all optional; the values shown are the defaults) ----
# Canonical domain. Any other host (e.g. staging) gets "X-Robots-Tag: noindex" automatically.
PRIMARY_DOMAIN=redecorgroup.com
# Optional token for detailed /api/health/ready output (header X-Health-Token). Empty = details for admins only.
HEALTH_TOKEN=
# Old-site URL -> new path 301 map (JSON). Leave empty to use deploy/redirects.json from the image.
REDIRECTS_FILE=
# Publication gate: 1 = only items with a recorded approval are public. 0 is refused in production.
ENFORCE_APPROVALS=1
# Photo quality rules (pixels / width-to-height ratio)
IMAGE_MIN_LONG_EDGE=1600
IMAGE_MIN_COVER_LONG_EDGE=2400
IMAGE_ASPECT_MIN=0.5
IMAGE_ASPECT_MAX=2.4
# Quote-form attachments (stored in the private redecor-attachments volume)
ATTACH_MAX_FILES=3
ATTACH_MAX_FILE_MB=15
ATTACH_MAX_TOTAL_MB=30
# Virus scanning of attachments with ClamAV: 1 also needs  docker compose --profile virus-scan up -d  (about 1-1.5 GB RAM)
VIRUS_SCAN_ENABLED=0
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Daily enquiries digest to NOTIFY_TO at HH:MM (empty = off), in this time zone
DIGEST_TIME=
DIGEST_TZ=Africa/Cairo
