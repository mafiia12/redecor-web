# Production settings. Copy to .env on the server and fill in. NEVER commit .env.
APP_ENV=production
SITE_DOMAIN=redecorgroup.com
SITE_URL=https://redecorgroup.com
# 48+ random characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# First admin account (created on first start). 12+ characters, letters and numbers/symbols.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO=0
ALLOW_TEST_CONTENT=0

# Enquiry e-mails (ask the e-mail provider for these; Microsoft 365: smtp.office365.com 587 starttls)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
NOTIFY_TO=

# Optional: alerts (failed notifications, server errors, failed backups) to a Slack/Teams/Discord webhook
ALERT_WEBHOOK_URL=
# Backups (the backup service writes to /data/backups inside the volume)
BACKUP_KEEP=14
BACKUP_COPY_TO=
